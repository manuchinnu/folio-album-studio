{
  "name": "folio-album-studio", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "schema": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx apps/cli/demo.ts",
    "import": "tsx apps/cli/import.ts",
    "verify": "npm run typecheck && npm run schema:check && npm test"
  },
  "dependencies": {"@sinclair/typebox": "0.34.41"},
  "devDependencies": {"@types/node": "24.3.0", "tsx": "4.20.5", "typescript": "5.9.2"}
}
